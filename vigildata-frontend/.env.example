# Supabase: URL del proyecto y publishable (anon) key.
# Tomar de Supabase dashboard > Project Settings > API.
VITE_SUPABASE_URL=https://xxxxx.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxx

# HU-10 - Auth con Google se hace via Supabase Auth (signInWithOAuth).
# Para habilitarlo:
# 1) Supabase dashboard > Authentication > Providers > Google: enable y
#    pegar Client ID + Client Secret obtenidos de Google Cloud Console.
# 2) En Google Cloud Console > Credentials > OAuth client (Web app) agregar:
#    - Authorized redirect URI: https://<PROJECT>.supabase.co/auth/v1/callback
# 3) Supabase > Authentication > URL Configuration > Site URL = http://localhost:5173
#    Y agregar http://localhost:5173/login a Redirect URLs.
