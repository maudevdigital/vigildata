# Copia este archivo a .env y descomenta UNA de las dos opciones de DATABASE_URL.

# === Opción A: Supabase (producción) ===
# Reemplazar <PROJECT_REF>, <PASSWORD>, <REGION> con los datos del proyecto.
# Tomar de Supabase dashboard -> Project Settings -> Database -> Connection string -> URI.
# DATABASE_URL=postgresql://postgres.<PROJECT_REF>:<PASSWORD>@aws-0-<REGION>.pooler.supabase.com:5432/postgres?sslmode=require

# === Opción B: SQLite local (demo / desarrollo sin red) ===
# No requiere credenciales. La BD se crea automáticamente al primer arranque.
# Útil para grabar el video demo si Supabase no está disponible.
DATABASE_URL=sqlite:///./local-demo.db

SECRET_KEY=cambiar-en-produccion
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# HU-10 - Verificacion del access_token JWT de Supabase Auth (Google).
# Proyectos nuevos usan claves asimetricas (ES256). El backend descarga la
# clave publica desde <SUPABASE_URL>/auth/v1/.well-known/jwks.json.
SUPABASE_URL=https://mdcualtcxwlxsivemkmf.supabase.co
# (Opcional) Fallback para tokens legacy firmados con HS256.
# SUPABASE_JWT_SECRET=
